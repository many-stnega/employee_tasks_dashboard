TELEGRAM_BOT_TOKEN=replace-with-bot-token-from-botfather
TELEGRAM_TASK_ASSIGN_USER_IDS=
TELEGRAM_STANDARD_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_REPORT_RECEIVED_CHAT_IDS=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_GROUP_CHAT_ALLOWED=no
TELEGRAM_REPORT_RECEIVED_GROUP_CHAT=no

# Public DNS name pointing to the VPS; obtain its TLS certificate before deploy.
DOMAIN=dashboard.example.com

# Run ./setup_dashboard_auth.sh to set the username, hash your password, and
# generate a random session signing key.
WEB_DASHBOARD_USERNAME=
WEB_DASHBOARD_PASSWORD_HASH=
WEB_DASHBOARD_SECRET_KEY=
